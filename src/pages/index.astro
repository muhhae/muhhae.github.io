---
/**
 * MAIN PAGE (ENGLISH)
 * ==========================
 *
 * This is the home page of the portfolio in English.
 * Route: / (root of the site)
 * URL: https://your-domain.com/
 *
 * PURPOSE:
 * - Main page in English (default language)
 * - Assembles all the portfolio components
 * - Configures meta tags and SEO for English
 * - Main entry point of the site
 *
 * STRUCTURE:
 * - Layout: Main container with HTML, head, and meta tags
 * - Hero: Personal presentation section
 * - Projects: Project gallery with filters
 * - Footer: Contact information and social media
 *
 * OPERATION:
 * - All code between --- --- runs on the server (SSG)
 * - Static HTML is generated at build time
 * - The generated HTML includes all components already rendered
 *
 * CUSTOMIZATION:
 * - You DO NOT need to modify this file to customize content
 * - Content is managed from:
 *   - src/i18n/translations.ts (texts)
 *   - src/data/projects-data.ts (projects)
 *   - src/components/ (visual design)
 *
 * SPANISH VERSION:
 * The Spanish version is in: src/pages/es/index.astro
 */

// IMPORTS
// -------------
// Layout: Main HTML container with meta tags
import Layout from '../layouts/Layout.astro';

// Page components
import Hero from '../components/Hero.astro';      // Main presentation section
import Projects from '../components/Projects.astro';  // Project gallery
import Publications from '../components/Pubs.astro';  // Project gallery
import Footer from '../components/Footer.astro';     // Footer with contact

// Internationalization utility to get translations
import { useI18n } from '../lib/i18n.js';

// LANGUAGE CONFIGURATION
// -----------------------
// Gets the English translations from translations.ts
// The 't' const contains all the texts in English
const { t } = useI18n();
---

<!--
  HTML STRUCTURE
  ===============
  Layout: Wrapper component that generates <html>, <head>, and <body>

  LAYOUT PROPS:
  - title: Title that appears in the browser tab
  - description: Meta description for SEO (Google, Bing, etc.)
  - lang: Language code for the <html lang=""> attribute

  SEO BENEFITS:
  - Custom title for each language improves ranking
  - Optimized description increases CTR in search results
  - Correct lang helps search engines to index properly
-->
<Layout
  title={t.siteTitle}
  description={t.siteDescription}
>
  <!--
    MAIN CONTENT
    ============
    Main container with id for accessibility
    The id allows direct navigation with "skip to content"

    INCLUDED COMPONENTS:
    1. Hero: Welcome section with name, title, and description
    2. Projects: Project showcase with technology filtering
    3. Footer: Contact information, social media, and copyright

    NOTE: All components receive lang="en" to render
    content in English from translations.ts
  -->
  <main id="main-content">
    <Hero />
    <Publications />
    <Projects />
    <Footer />
  </main>
</Layout>

<!--
  TECHNICAL NOTES
  ==============

  1. STATIC SITE GENERATION (SSG):
     This page is generated at build time, not runtime.
     Command: npm run build
     Output: dist/index.html

  2. DEFAULT LANGUAGE:
     This page is the root (/), so it is the default language.
     Visitors accessing https://your-domain.com/ will see this version.

  3. LANGUAGE CHANGE:
     The LanguageSwitcher component (included in Layout) allows
     switching between Spanish (/es/index.html) and English (/index.html)

  4. MULTILINGUAL SEO:
     Layout.astro includes <link rel="alternate"> tags that indicate
     to Google that an alternative version in Spanish exists.

  5. PERFORMANCE:
     - Static HTML = instant loading
     - No JavaScript needed to render content
     - Minified CSS in production
     - Images automatically lazy-loaded

  HOW TO VERIFY:
  - Development: npm run dev → http://localhost:4321
  - Production: npm run build && npm run preview
-->
