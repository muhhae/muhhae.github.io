---
import { useI18n } from '../lib/i18n.js';
const { t } = useI18n();
const currentYear = new Date().getFullYear();

/*
 * EXAMPLES OF ADDITIONAL NETWORKS:
 * { name: "Email", url: "mailto:your@email.com" },
 * { name: "Portfolio", url: "https://your-site.com" },
 * { name: "Dev.to", url: "https://dev.to/yourusername" },
 * { name: "CodePen", url: "https://codepen.io/yourusername" }
 */
const socialLinks = [
  { name: "GitHub", url: "https://github.com/muhhae" },      // Code repositories
  { name: "itch.io", url: "https://muhhae.itch.io/" },      // Code repositories
  { name: "Twitter", url: "https://x.com/haemuhh" },    // Social network / X
  { name: "LinkedIn", url: "https://linkedin.com/in/muhhae" } // Professional network
];
---
<footer id="contact" class="footer border-top">
  <div class="container">
    <div class="footer-content">
      <div class="footer-main">
        <h2 class="mono">{t.contactTitle}</h2>
        <button class="reveal-email mono" id="reveal-email">
          {t.contactEmailButton}
        </button>
        <div class="email-display mono" id="email-display" style="display: none;">
          <span class="email-link" id="email-text"></span>
        </div>
      </div>
      <div class="footer-links">
        <h3 class="mono">{t.contactLinks}</h3>
        <nav class="social-links">
          {socialLinks.map(link => (
            <a href={link.url} target="_blank" rel="noopener noreferrer">
              {link.name}
            </a>
          ))}
        </nav>
      </div>
    </div>
    <div class="footer-bottom">
      <p class="mono">
      <!-- {t.footerCopyright.replace('{year}', currentYear.toString())}, -->
      forked from <a href='https://github.com/686f6c61/Portfolio-Astro-Template'>686f6c61/Portfolio-Astro-Template</a>
      </p>

      <!--
        STATUS INDICATOR:
        - Indicator of availability for work
        - ● with pulse animation (blinking)
        - Configurable text in translations.ts
        - Example: "Available for projects"
      -->
      <p class="mono">
        <span class="status">●</span> {t.footerStatus}
      </p>
    </div>
  </div>
</footer>

<style>
  /**
   * STYLES: Footer
   * ---------------
   *
   * DESIGN:
   * - 2-column grid layout on desktop
   * - Single column layout on mobile
   * - Generous spacing for visual breathing room
   * - Subtle animations on interactions
   *
   * CSS VARIABLES USED:
   * - var(--border): Border color
   * - var(--text): Text color
   * - var(--bg): Background color
   * - var(--mono): Monospace font
   *
   * RESPONSIVE:
   * - Desktop: 2 columns (contact + networks)
   * - Mobile: 1 vertical column
   */

  /**
   * CONTAINER: .footer
   * -------------------
   * Footer spacing
   */
  .footer {
    padding: 4rem 0 2rem;  /* 64px top, 32px bottom */
    margin-top: 4rem;      /* 64px separation from previous content */
  }

  /**
   * CONTENT: .footer-content
   * --------------------------
   * 2-column grid on desktop
   * Left column (contact) takes up more space than right (networks)
   */
  .footer-content {
    display: grid;
    grid-template-columns: 2fr 1fr;  /* Left column 2x wider than right */
    gap: 4rem;                       /* 64px space between columns */
    margin-bottom: 3rem;             /* 48px space below */
  }

  /**
   * TITLE: h2 of footer
   * ---------------------
   * Spacing of "Contact" title
   */
  .footer-main h2 {
    margin-bottom: 1rem;  /* 16px space below */
  }

  /**
   * BUTTON: .reveal-email
   * --------------------
   * Button to reveal the email
   * Similar to the design of secondary Hero buttons
   */
  .reveal-email {
    background: transparent;
    border: 2px solid var(--border);   /* Theme-adaptive border */
    color: var(--text);                /* Theme-adaptive color */
    padding: 0.75rem 1.5rem;           /* 12px vertical, 24px horizontal */
    cursor: pointer;                   /* Indicates it's clickable */
    transition: all 0.3s;              /* Smooth 300ms animation */
    font-family: var(--mono);          /* Monospace font */
    font-size: 0.9rem;                 /* 14.4px */
    margin-bottom: 1rem;               /* 16px space below */
  }

  /**
   * HOVER: reveal-email button
   * -------------------------
   * Effect on mouse hover
   */
  .reveal-email:hover {
    border-color: var(--text);        /* More prominent border */
    transform: translateY(-2px);      /* Lifts 2px up */
  }

  /**
   * CONTAINER: .email-display
   * --------------------------
   * Container of the revealed email
   * Appears with fadeIn animation when shown
   */
  .email-display {
    margin-top: 1rem;              /* 16px space above */
    animation: fadeIn 0.5s ease-in;  /* Appearance animation */
  }

  /**
   * ANIMATION: fadeIn
   * -----------------
   * Smooth appearance of the revealed email
   * Combines fade (opacity) + slide (movement)
   */
  @keyframes fadeIn {
    from {
      opacity: 0;                     /* Starts invisible */
      transform: translateY(-10px);   /* Starts 10px up */
    }
    to {
      opacity: 1;                     /* Ends fully visible */
      transform: translateY(0);       /* Ends in original position */
    }
  }

  /**
   * EMAIL LINK: .email-link
   * -----------------------
   * Styles of the revealed email link
   * Highlighted to be easy to see
   */
  .email-link {
    font-size: 1.25rem;      /* 20px - Large and visible */
    font-weight: 500;        /* Semi-bold to stand out */
    display: inline-block;
  }

  /**
   * TITLE: h3 of links
   * ---------------------
   * "Links" title in the right column
   * Smaller and less prominent
   */
  .footer-links h3 {
    font-size: 0.9rem;      /* 14.4px - Small */
    margin-bottom: 1rem;    /* 16px space below */
    opacity: 0.7;           /* 70% visible - Less prominent */
  }

  /**
   * CONTAINER: .social-links
   * -------------------------
   * List of social links in a vertical column
   */
  .social-links {
    display: flex;
    flex-direction: column;  /* Vertical */
    gap: 0.75rem;            /* 12px between each link */
  }

  /**
   * LINKS: .social-links a
   * ------------------------
   * Styles of each social link
   * Reduced opacity by default, increases on hover
   */
  .social-links a {
    opacity: 0.7;              /* 70% visible by default */
    transition: opacity 0.2s;  /* Smooth 200ms transition */
  }

  /**
   * HOVER: Social links
   * -----------------------
   * Increases opacity on mouse hover
   */
  .social-links a:hover {
    opacity: 1;  /* 100% visible on hover */
  }

  /**
   * BOTTOM SECTION: .footer-bottom
   * --------------------------------
   * Container for copyright and status
   * Visually separated with a top border
   */
  .footer-bottom {
    padding-top: 2rem;                    /* 32px space above */
    border-top: 1px solid var(--border);  /* Separator line */
    display: flex;
    justify-content: space-between;       /* Copyright left, status right */
    align-items: center;                  /* Centered vertical alignment */
    font-size: 0.85rem;                   /* 13.6px - Small */
    opacity: 0.6;                         /* 60% visible - Secondary information */
  }

  /**
   * STATUS INDICATOR: .status
   * -------------------------
   * Dot (●) indicating availability
   * Green color with pulse animation
   */
  .status {
    color: #00ff00;              /* Bright green (terminal green) */
    animation: pulse 2s infinite;  /* Blinks every 2 seconds, infinitely */
  }

  /**
   * ANIMATION: pulse
   * ----------------
   * Makes the status indicator blink
   * Simulates "online" or "available" indicator
   */
  @keyframes pulse {
    0%, 100% { opacity: 1; }    /* Start and end: fully visible */
    50% { opacity: 0.5; }       /* Middle: semi-transparent */
  }

  /**
   * RESPONSIVE: Mobile
   * ------------------
   * Adjustments for small screens (max-width: 768px)
   */
  @media (max-width: 768px) {
    /**
     * Single column content
     * On mobile, contact and networks stack vertically
     */
    .footer-content {
      grid-template-columns: 1fr;  /* 1 column */
      gap: 3rem;                   /* 48px between sections */
    }

    /**
     * Vertical footer bottom
     * Copyright and status stack on mobile
     */
    .footer-bottom {
      flex-direction: column;  /* From horizontal to vertical */
      gap: 1rem;               /* 16px between elements */
      text-align: center;      /* Centered text */
    }
  }
</style>

<script>
  /**
   * SCRIPT: Email Revelation System
   * ================================
   *
   * This script handles the revelation of the contact email with obfuscation.
   * It runs in the browser (client-side) after the page loads.
   *
   * PURPOSE:
   * Protect the email from spam bots through Base64 obfuscation.
   * Bots cannot read the email from the HTML because it is built dynamically.
   *
   * HOW OBFUSCATION WORKS:
   * 1. The email is split into user + domain
   * 2. Each part is encoded in Base64
   * 3. The Base64 code is stored in the script
   * 4. On click, it is decoded and the full email is constructed
   * 5. A mailto: link is created dynamically
   *
   * ADVANTAGES:
   * - Email NOT visible in the initial HTML
   * - Bots cannot scrape it from the source code
   * - Real humans can easily access it
   * - Includes Analytics tracking
   *
   * HOW TO ENCODE YOUR EMAIL IN BASE64:
   * 1. Go to: https://www.base64encode.org/
   * 2. Encode the user (part before the @)
   *    Example: "yourname" → "eW91cm5hbWU="
   * 3. Encode the domain (part after the @)
   *    Example: "example.com" → "ZXhhbXBsZS5jb20="
   * 4. Replace the values in the marked lines below
   */

  // EVENT LISTENER: DOMContentLoaded
  // ---------------------------------
  // Waits for all HTML to be loaded before executing
  document.addEventListener('DOMContentLoaded', () => {
    // DOM REFERENCES
    // ------------------
    // Find the necessary elements by their IDs
    const revealButton = document.getElementById('reveal-email');  // Reveal button
    const emailDisplay = document.getElementById('email-display');  // Email container
    const emailText = document.getElementById('email-text');        // Span where the link will go

    // VALIDATION
    // ----------
    // Verify that all elements exist before continuing
    if (revealButton && emailDisplay && emailText) {
      // EVENT LISTENER: Click on button
      // -------------------------------
      // Executes when the user clicks on "Reveal Email"
      revealButton.addEventListener('click', () => {
        // GOOGLE ANALYTICS
        // ----------------
        // Registers the email revelation event
        // Only if Google Analytics is configured
        if (typeof gtag !== 'undefined') {
          gtag('event', 'reveal_email', {
            event_category: 'contact',       // Category: Contact
            event_label: 'email_revealed'    // Label: Email revealed
          });
        }

        /**
         * EMAIL DECODING
         * ------------------------
         * Constructs the full email by decoding the Base64 parts
         *
         * ⚠️ CUSTOMIZE HERE ⚠️
         * Replace the Base64 strings with those of your email:
         *
         * STEP 1: Encode your user (before @)
         * Go to https://www.base64encode.org/
         * Enter only your user (e.g., "yourname")
         * Copy the result and replace 'eW91cnVzZXJuYW1l'
         *
         * STEP 2: Encode your domain (after @)
         * Enter your domain (e.g., "gmail.com")
         * Copy the result and replace 'ZXhhbXBsZS5jb20='
         *
         * REAL EXAMPLE:
         * Email: john.doe@gmail.com
         * User: "john.doe" → Base64: "am9obi5kb2U="
         * Domain: "gmail.com" → Base64: "Z21haWwuY29t"
         * const user = atob('am9obi5kb2U=');
         * const domain = atob('Z21haWwuY29t');
         */
        const user = atob('aGFla2FsLm11aGFtYXQ=');   // Base64 of "yourusername" ← CHANGE
        const domain = atob('Z21haWwuY29t'); // Base64 of "example.com" ← CHANGE
        const email = user + '@' + domain;        // Builds: user@domain

        // LINK CREATION
        // -----------------
        // Dynamically creates an <a> element with the email
        const link = document.createElement('a');
        link.href = 'mailto:' + email;  // mailto: link to open email client
        link.textContent = email;       // Visible text of the email
        link.className = 'email-link';  // CSS class for styles

        // DOM INSERTION
        // -------------------
        // Adds the link to the container
        emailText.appendChild(link);

        // UI UPDATE
        // -------------------
        // Hides the button and shows the email
        revealButton.style.display = 'none';   // Hides "Reveal Email" button
        emailDisplay.style.display = 'block';  // Shows email container
      });
    }
  });
</script>

<!--
  HOW TO CUSTOMIZE THE FOOTER
  ===========================

  1. CHANGE TEXTS:
     Edit src/i18n/translations.ts
     Look for the keys:
     - contactTitle: "Contact"
     - contactEmailButton: "Reveal Email"
     - contactLinks: "Links"
     - footerCopyright: "© {year} Your Name"
     - footerStatus: "Available for projects"

  2. CONFIGURE YOUR EMAIL:
     See detailed instructions in the script above
     Basically:
     a) Go to https://www.base64encode.org/
     b) Encode user and domain separately
     c) Replace the Base64 values in the marked lines

  3. UPDATE SOCIAL NETWORKS:
     Edit the socialLinks array in the frontmatter (lines 82-86)
     Replace "yourusername" with your real username
     Add or remove networks as needed

  4. CHANGE STATUS COLOR:
     Line 387: color: #00ff00;
     Replace #00ff00 (green) with another color
     Examples:
     - #ff0000: Red (busy)
     - #ffff00: Yellow (partially available)
     - #0080ff: Blue (freelance)

  5. REMOVE STATUS INDICATOR:
     Delete lines 186-194 from the HTML
     The animated dot and status text will disappear

  6. CHANGE GRID LAYOUT:
     Line 239: grid-template-columns: 2fr 1fr;
     - 2fr 1fr: Contact takes 2/3, networks 1/3
     - 1fr 1fr: Both columns equal
     - 3fr 1fr: Contact takes 3/4, networks 1/4

  VERIFY OBFUSCATION:
  1. Open the site in your browser
  2. Right click → "View page source"
  3. Search for your email (Ctrl+F)
  4. If your real email does NOT appear, obfuscation is working ✓
  5. If it appears, check that the Base64 lines are correct
-->
