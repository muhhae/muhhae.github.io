---
/**
 * COMPONENT: Theme Toggle
 * =========================
 *
 * Floating button that allows switching between light and dark mode.
 * Position: Top right of the screen (fixed)
 *
 * FUNCTIONALITY:
 * - Automatically detects the system theme on load
 * - Allows manual switching between light/dark
 * - Persists the user's preference in localStorage
 * - Listens for changes in system preferences
 * - Includes analytics tracking (optional)
 *
 * ARCHITECTURE:
 * - HTML: Button with SVG icons (sun and moon)
 * - CSS: Styles with smooth and responsive transitions
 * - JavaScript: Theme change logic with persistence
 *
 * INTEGRATION:
 * It is automatically included in Layout.astro
 * You do not need to import it manually on pages
 *
 * ACCESSIBILITY:
 * - aria-label and title for screen readers
 * - Localized text according to language (es/en)
 * - Visible focus for keyboard navigation
 * - Visual indicator of the current theme
 */
---

<!--
  THEME TOGGLE BUTTON
  ========================

  STRUCTURE:
  - Button with unique id for JavaScript
  - Two SVG icons: sun (light) and moon (dark)
  - Only one is shown at a time depending on the current theme

  ACCESSIBILITY ATTRIBUTES:
  - aria-label: Describes the action for screen readers
  - title: Tooltip on mouse hover
  - Both texts localized according to language
-->
<button
  id="theme-toggle"
  aria-label='Toggle theme'
  title='Toggle theme'
>
  <!--
    ICON: SUN (Light Mode)
    Shown when the theme is light
    SVG draws a stylized sun with rays
  -->
  <svg class="sun-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
    <circle cx="10" cy="10" r="4" stroke="currentColor" stroke-width="2"/>
    <line x1="10" y1="2" x2="10" y2="4" stroke="currentColor" stroke-width="2"/>
    <line x1="10" y1="16" x2="10" y2="18" stroke="currentColor" stroke-width="2"/>
    <line x1="18" y1="10" x2="16" y2="10" stroke="currentColor" stroke-width="2"/>
    <line x1="4" y1="10" x2="2" y2="10" stroke="currentColor" stroke-width="2"/>
    <line x1="15.5" y1="4.5" x2="14.5" y2="5.5" stroke="currentColor" stroke-width="2"/>
    <line x1="5.5" y1="14.5" x2="4.5" y2="15.5" stroke="currentColor" stroke-width="2"/>
    <line x1="15.5" y1="15.5" x2="14.5" y2="14.5" stroke="currentColor" stroke-width="2"/>
    <line x1="5.5" y1="5.5" x2="4.5" y2="4.5" stroke="currentColor" stroke-width="2"/>
  </svg>

  <!--
    ICON: MOON (Dark Mode)
    Shown when the theme is dark
    SVG draws a crescent moon
  -->
  <svg class="moon-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M17 10.5C17 14.6421 13.6421 18 9.5 18C5.35786 18 2 14.6421 2 10.5C2 6.35786 5.35786 3 9.5 3C9.67793 3 9.85464 3.00696 10.0297 3.02063C9.38507 3.93644 9 5.06876 9 6.29032C9 9.43248 11.5675 12 14.7097 12C15.9312 12 17.0636 11.6149 17.9794 10.9703C17.993 11.1454 18 11.322 18 11.5" stroke="currentColor" stroke-width="2"/>
  </svg>
</button>

<style>
  /**
   * STYLES: Theme Button
   * -----------------------
   *
   * POSITIONING:
   * - fixed: Remains visible on scroll
   * - top/right: Position in the top right corner
   * - z-index: 999 to be above other elements
   *
   * DESIGN:
   * - Transparent background to integrate with any theme
   * - Subtle border that uses CSS variable (adapts to theme)
   * - 40x40px square size to maintain proportion
   *
   * CUSTOMIZATION:
   * Change top/right to move the position
   * Change width/height for a different size
   */
  #theme-toggle {
    position: fixed;
    top: 4rem;
    right: 1rem;
    z-index: 999;
    background: transparent;
    border: 1px solid var(--border);
    padding: 0.5rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s;
    width: 40px;
    height: 40px;
  }

  /**
   * STATE: Hover
   * -------------
   * Visual effects when the user hovers the mouse
   * - More visible border (text color)
   * - Slight upward movement ("lift" effect)
   */
  #theme-toggle:hover {
    border-color: var(--text);
    transform: translateY(-2px);
  }

  /**
   * ICONS: Colors
   * ---------------
   * The icons use var(--text) to automatically adapt to the theme
   * In light mode: dark text
   * In dark mode: light text
   */
  .sun-icon,
  .moon-icon {
    color: var(--text);
  }

  /**
   * ICON VISIBILITY
   * ----------------------
   * Only one icon is shown at a time depending on the current theme:
   *
   * WITHOUT data-theme attribute or data-theme="dark":
   * - Sun hidden (display: none)
   * - Moon visible (display: block)
   *
   * WITH data-theme="light":
   * - Sun visible (display: block)
   * - Moon hidden (display: none)
   *
   * LOGIC:
   * The icon shown indicates the CURRENT theme, not the next one.
   * If you see the moon = you are in dark mode
   * If you see the sun = you are in light mode
   */
  .sun-icon {
    display: none;  /* Hidden by default (dark mode by default) */
  }

  .moon-icon {
    display: block;  /* Visible by default (dark mode by default) */
  }

  /* Active light mode */
  [data-theme="light"] .sun-icon {
    display: block;   /* Show sun in light mode */
  }

  [data-theme="light"] .moon-icon {
    display: none;    /* Hide moon in light mode */
  }

  /* Active dark mode */
  [data-theme="dark"] .sun-icon {
    display: none;    /* Hide sun in dark mode */
  }

  [data-theme="dark"] .moon-icon {
    display: block;   /* Show moon in dark mode */
  }

  
</style>

<script>
  /**
   * SCRIPT: Theme Change Logic
   * =================================
   *
   * This script handles all the functionality of the theme button.
   * It runs in the browser (client-side) after the page loads.
   *
   * WORKFLOW:
   * 1. On load: Detects saved theme or system preference
   * 2. On click: Toggles between light and dark
   * 3. On system theme change: Updates if there is no manual preference
   * 4. Persists: Saves preference in localStorage
   *
   * COMPATIBILITY:
   * - localStorage: All modern browsers
   * - matchMedia: System theme detection
   * - gtag: Google Analytics (optional, does not break if not present)
   */

  // DOM REFERENCES
  // ------------------
  const themeToggle = document.getElementById('theme-toggle');
  const html = document.documentElement;  // <html> element

  /**
   * FUNCTION: getTheme
   * -----------------
   * Determines which theme to apply when the page loads.
   *
   * PRIORITY:
   * 1. Theme saved in localStorage (user preference)
   * 2. Operating system theme (prefers-color-scheme)
   *
   * RETURNS:
   * 'light' or 'dark'
   *
   * EXAMPLE:
   * - User on macOS with dark mode activated → 'dark'
   * - User who manually switched to light → 'light' (persists)
   */
  function getTheme() {
    const stored = localStorage.getItem('theme');
    if (stored) return stored;  // Saved manual preference

    // Detect system preference
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  /**
   * FUNCTION: setTheme
   * -----------------
   * Applies a theme to the site and saves it in localStorage.
   *
   * PARAMETERS:
   * @param theme - 'light' or 'dark'
   * @param trackChange - If true, registers event in Google Analytics
   *
   * WHAT IT DOES:
   * 1. Adds data-theme="light" or "dark" attribute to <html>
   * 2. Saves preference in localStorage
   * 3. (Optional) Registers change in Google Analytics
   *
   * THE data-theme ATTRIBUTE:
   * It is used by CSS to change colors via CSS variables:
   * [data-theme="dark"] { --bg: #000; --text: #fff; }
   * [data-theme="light"] { --bg: #fff; --text: #000; }
   */
  function setTheme(theme: string, trackChange = false) {
    html.setAttribute('data-theme', theme);
    localStorage.setItem('theme', theme);

    // ANALYTICS (Optional)
    // If Google Analytics is configured, registers the change
    // Only tracks manual changes (trackChange = true), not automatic ones
    if (trackChange && typeof gtag !== 'undefined') {
      gtag('event', 'change_theme', {
        event_category: 'user_preferences',
        theme: theme,
        event_label: theme
      });
    }
  }

  /**
   * INITIALIZATION
   * --------------
   * Executes immediately when the page loads.
   * Detects and applies the initial theme before the user sees content.
   *
   * IMPORTANT:
   * This prevents the "flash" of incorrect theme on load.
   */
  const initialTheme = getTheme();
  setTheme(initialTheme);

  /**
   * EVENT LISTENER: Click on button
   * -------------------------------
   * Toggles between light and dark when the user clicks.
   *
   * OPERATION:
   * 1. Reads the current theme from data-theme
   * 2. Calculates the opposite theme
   * 3. Applies the new theme with setTheme()
   * 4. trackChange=true to register in Analytics
   */
  themeToggle?.addEventListener('click', () => {
    const currentTheme = html.getAttribute('data-theme');
    const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
    setTheme(newTheme, true);  // true = track in analytics
  });

  /**
   * EVENT LISTENER: System theme change
   * -------------------------------------------
   * Listens for changes in the operating system's prefers-color-scheme.
   *
   * USE CASE:
   * User on macOS/Windows switches between light/dark mode in settings.
   * The site updates automatically ONLY if the user has NOT chosen
   * a manual preference.
   *
   * LOGIC:
   * If localStorage.theme exists → User chose manually → DO NOT update
   * If it does not exist → User has not chosen → YES update with system preference
   *
   * BENEFIT:
   * Respects the user's manual preference over the system's.
   */
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    // Only update if there is NO saved manual preference
    if (!localStorage.getItem('theme')) {
      setTheme(e.matches ? 'dark' : 'light');
    }
  });
</script>

<!--
  HOW THEME CHANGE WORKS
  ================================

  1. CSS VARIABLES (global.css):
     :root { --bg: #fff; --text: #000; }
     [data-theme="dark"] { --bg: #000; --text: #fff; }

  2. THIS COMPONENT:
     - Adds/removes data-theme="dark" or "light" to <html>
     - CSS automatically applies the corresponding colors

  3. PERSISTENCE:
     - localStorage saves the preference
     - On page reload, the saved theme is applied

  4. AUTOMATIC DETECTION:
     - If no preference is saved, uses system theme
     - Updates if the user changes theme in their OS

  CUSTOMIZE COLORS:
  Edit the CSS variables in src/styles/global.css
  You DO NOT need to modify this file.
-->
