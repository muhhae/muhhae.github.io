---
/**
 * COMPONENT: Hero
 * ================
 *
 * Main presentation section of the portfolio.
 * First section visitors see when they arrive at the site.
 *
 * PURPOSE:
 * - Personal presentation with name, title, and description
 * - Call-to-action (CTA) to view projects
 * - Button to access the template on GitHub
 * - Create a professional first impression
 *
 * CONTENT DISPLAYED:
 * - Greeting (e.g., "Hello, I'm")
 * - Name/Main title with blinking cursor
 * - Subtitle (e.g., "Full Stack Developer")
 * - Brief description of skills and experience
 * - CTA buttons (View projects + View template)
 *
 * ARCHITECTURE:
 * - HTML: Semantic content with <section>, <h1>, etc.
 * - CSS: Minimalist design with subtle animations
 * - Internationalization: All content comes from translations.ts
 * - Responsive: Adapts perfectly to mobile
 *
 * ANIMATIONS:
 * - Blinking cursor (_) at the end of the title
 * - Fade-in animation on load (defined in global.css)
 * - Hover effect on buttons with movement
 *
 * CUSTOMIZATION:
 * - DO NOT modify this file
 * - All content is edited in: src/i18n/translations.ts
 * - Look for the keys: heroGreeting, heroTitle, heroSubtitle, etc.
 */

// IMPORTS
// -------------
// Internationalization utility to get translations
import { useI18n } from '../lib/i18n.js';

const { t } = useI18n();
---

<!--
  HERO SECTION
  ============

  HTML STRUCTURE:
  - <section>: Main semantic container
  - .container: Class to center content (defined in global.css)
  - .hero-content: Content container with max-width
  - .fade-in: Appearance animation on load (global.css)

  ELEMENTS:
  1. Greeting: Small introductory text
  2. Title (h1): Name with blinking cursor
  3. Subtitle: Your role or specialty
  4. Description: Brief summary of skills/experience (supports HTML)
  5. CTAs: Action buttons (projects + template)

  MONO CLASSES:
  - .mono: Applies monospace font (defined in global.css)
  - Used in almost all texts for terminal/code style

  SEO:
  - <h1> is the main title of the page (critical for SEO)
  - There should only be one <h1> per page
  - The content is the most important for Google
-->
<section class="hero">
  <!-- Centered container (global.css) -->
  <div class="container">
    <!-- Content with appearance animation -->
    <div class="hero-content fade-in">
      <!-- GREETING: Small introductory text -->
      <p class="mono greeting">{t.heroGreeting}</p>

      <!--
        MAIN TITLE (h1):
        - Name or personal brand
        - Includes blinking cursor (_) with animation
        - It is the most important SEO element of the page
      -->
      <h1>{t.heroTitle}<span class="blink">_</span></h1>

      <!--
        SUBTITLE:
        - Your role, specialty, or professional title
        - E.g: "Full Stack Developer", "UI/UX Designer"
      -->
      <p class="subtitle mono">
        {t.heroSubtitle}
      </p>

      <!--
        DESCRIPTION:
        - Brief summary of skills, experience, or value proposition
        - set:html allows HTML in the text (e.g., <br>, <strong>)
        - Caution: Only use with trusted content (not user input)
      -->
      <p class="description mono" set:html={t.heroDescription}></p>

      <!--
        CALL TO ACTIONS (CTAs):
        - Primary button: Scroll to projects section (#projects)
        - Secondary button: Link to the template repo on GitHub
      -->
      <div class="cta">
        <!--
          PRIMARY BUTTON: View projects
          - href="#projects": Smooth scroll to section (global.css)
          - Highlighted style (solid background)
        -->
        <a href="#projects" class="btn-primary mono">{t.heroCta}</a>

        <!--
          SECONDARY BUTTON: View template
          - External link to GitHub with your template
          - target="_blank": Opens in a new tab
          - rel="noopener": Security (prevents tabnabbing)
          - Secondary style (transparent background)

          CUSTOMIZE:
          Change "yourusername/your-template-repo" to your real repo
        -->
        <!-- <a href="https://github.com/yourusername/your-template-repo" target="_blank" rel="noopener" class="btn-secondary mono">{t.heroTemplateButton}</a> -->
        <a href="https://muhhae.github.io/resume/main.pdf" target="_blank" rel="noopener" class="btn-secondary mono">cat ~/cv.pdf</a>
      </div>
    </div>
  </div>
</section>

<style>
  /**
   * STYLES: Hero Section
   * ----------------------
   *
   * DESIGN:
   * - Vertically centered layout (flexbox)
   * - Left-aligned text with max-width for readability
   * - Clear visual hierarchy: greeting → title → subtitle → description → CTA
   * - Different opacities to create depth
   * - Subtle animations that do not distract
   *
   * CSS VARIABLES USED:
   * - var(--text): Text color (adapts to theme)
   * - var(--bg): Background color (adapts to theme)
   * - var(--mono): Monospace font
   *
   * RESPONSIVE:
   * - Desktop: Buttons in a horizontal row
   * - Mobile: Buttons in a vertical column
   *
   * CUSTOMIZATION:
   * - min-height: Minimum height of the section
   * - max-width: Maximum width of the content
   * - font-size: Relative text sizes
   */

  /**
   * CONTAINER: .hero
   * -----------------
   * Main section that occupies almost the entire height of the window
   */
  .hero {
    min-height: 90vh;     /* 90% of window height */
    display: flex;        /* Flexbox for vertical centering */
    align-items: center;  /* Centers content vertically */
    padding: 6rem 0;      /* 96px top and bottom */
  }

  /**
   * CONTENT: .hero-content
   * -------------------------
   * Limits the width of the text for better readability
   * Very wide text (>800px) is difficult to read
   */
  .hero-content {
    max-width: 800px;  /* Maximum width for optimal readability */
  }

  /**
   * GREETING: .greeting
   * -----------------
   * Small introductory text (e.g., "Hello, I'm")
   * Reduced opacity for lower visual hierarchy
   */
  .greeting {
    font-size: 0.9rem;      /* 14.4px - Slightly small */
    opacity: 0.7;           /* 70% visible - Less prominent */
    margin-bottom: 0.5rem;  /* 8px space below */
  }

  /**
   * MAIN TITLE: h1
   * --------------------
   * The name or personal brand
   * Inherits global h1 styles (global.css)
   */
  h1 {
    margin-bottom: 1rem;  /* 16px space below */
  }

  /**
   * CURSOR: .blink
   * --------------
   * Blinking cursor (_) at the end of the title
   * Simulates a terminal cursor typing
   */
  .blink {
    animation: blink 1s infinite;  /* Blinks every 1 second, infinitely */
  }

  /**
   * ANIMATION: blink
   * ----------------
   * Makes the cursor appear and disappear
   * 0-50%: Visible (opacity: 1)
   * 51-100%: Invisible (opacity: 0)
   */
  @keyframes blink {
    0%, 50% { opacity: 1; }    /* First half: visible */
    51%, 100% { opacity: 0; }  /* Second half: invisible */
  }

  /**
   * SUBTITLE: .subtitle
   * --------------------
   * Your role or specialty (e.g., "Full Stack Developer")
   * Slightly larger than normal text
   */
  .subtitle {
    font-size: 1.25rem;     /* 20px - Prominent but not as much as h1 */
    margin-bottom: 1.5rem;  /* 24px space below */
    opacity: 0.8;           /* 80% visible - Intermediate hierarchy */
  }

  /**
   * DESCRIPTION: .description
   * -------------------------
   * Brief summary of skills and experience
   * Lower opacity than subtitle for less emphasis
   */
  .description {
    font-size: 1.1rem;    /* 17.6px - Legible but secondary */
    margin-bottom: 2rem;  /* 32px space below */
    opacity: 0.7;         /* 70% visible - Lower hierarchy */
  }

  /**
   * TERMINAL INFO: .terminal-info
   * -----------------------------
   * Class for additional terminal-style information
   * (Currently not used in HTML but available)
   */
  .terminal-info {
    display: block;
    font-size: 0.9rem;    /* 14.4px - Small */
    opacity: 0.6;         /* 60% visible - Very secondary */
    margin-top: 0.5rem;   /* 8px above */
    font-style: italic;   /* Italic to differentiate */
  }

  /**
   * CTA CONTAINER: .cta
   * --------------------
   * Container for action buttons
   * Flexbox to align buttons horizontally
   */
  .cta {
    display: flex;        /* Flexbox for horizontal layout */
    gap: 1rem;            /* 16px space between buttons */
    flex-wrap: wrap;      /* Allows wrapping on small screens */
  }

  /**
   * BUTTONS: .btn-primary and .btn-secondary
   * ---------------------------------------
   * Base styles shared by both buttons
   * Differences are defined in specific rules below
   */
  .btn-primary,
  .btn-secondary {
    padding: 0.75rem 2rem;          /* 12px vertical, 32px horizontal */
    border: 2px solid var(--text);  /* Theme-adaptive border */
    transition: all 0.3s;           /* Smooth 300ms animation */
    display: inline-block;
    font-family: var(--mono);       /* Monospace font */
    font-size: 0.9rem;              /* 14.4px */
  }

  /**
   * PRIMARY BUTTON: .btn-primary
   * ----------------------------
   * Highlighted button with solid background
   * Higher visual hierarchy (main action)
   */
  .btn-primary {
    background: var(--text);  /* Background of text color (inverted) */
    color: var(--bg);         /* Text of background color (inverted) */
    border-bottom: none;      /* No bottom border */
  }

  /**
   * HOVER: Primary button
   * ---------------------
   * Effect on mouse hover
   */
  .btn-primary:hover {
    opacity: 1;                   /* Full opacity */
    transform: translateY(-2px);  /* Lifts 2px up */
  }

  /**
   * SECONDARY BUTTON: .btn-secondary
   * --------------------------------
   * Button with transparent background
   * Lower visual hierarchy (secondary action)
   */
  .btn-secondary {
    background: transparent;  /* Transparent background, only border */
  }

  /**
   * HOVER: Secondary button
   * -----------------------
   * Effect on mouse hover: fills with color
   */
  .btn-secondary:hover {
    background: var(--text);  /* Fills with text color */
    color: var(--bg);         /* Text changes to background color */
    opacity: 1;               /* Full opacity */
  }

  /**
   * RESPONSIVE: Mobile
   * ------------------
   * Adjustments for small screens (max-width: 768px)
   */
  @media (max-width: 768px) {
    /**
     * Shorter hero on mobile
     * Makes better use of limited vertical space
     */
    .hero {
      min-height: 80vh;  /* 80% height (was 90%) */
    }

    /**
     * Buttons in a vertical column
     * Better for narrow screens
     */
    .cta {
      flex-direction: column;  /* Changes from row to column */
    }

    /**
     * Centered button text
     * Looks better in vertical layout
     */
    .btn-primary,
    .btn-secondary {
      text-align: center;  /* Centers the button text */
    }
  }
</style>

<!--
  HOW TO CUSTOMIZE THE HERO
  =========================

  1. CHANGE TEXTS:
     Edit src/i18n/translations.ts
     Look for the keys:
     - heroGreeting: "Hello, I'm"
     - heroTitle: "Your Name"
     - heroSubtitle: "Your Role"
     - heroDescription: "Your description"
     - heroCta: "View Projects"
     - heroTemplateButton: "View Template"

  2. CHANGE TEMPLATE BUTTON LINK:
     Line 142 of this file
     Replace "yourusername/your-template-repo"
     With your real repository on GitHub

  3. ADJUST VISUAL DESIGN:
     Edit the styles in <style> above:
     - min-height: Height of the section
     - max-width: Width of the content
     - font-size: Text sizes
     - padding: Spacings

  4. CHANGE COLORS:
     Colors are defined in src/styles/global.css
     Look for the CSS variables:
     - --text: Text color
     - --bg: Background color
     - --border: Border color
     And they have versions for [data-theme="light"] and [data-theme="dark"]

  5. REMOVE BLINKING CURSOR:
     Delete: <span class="blink">_</span>
     On line 100 of this file

  6. REMOVE FADE-IN ANIMATION:
     Remove the "fade-in" class
     From line 90 of this file
-->
