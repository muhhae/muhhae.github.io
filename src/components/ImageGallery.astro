---
/**
 * COMPONENT: ImageGallery
 * =========================
 *
 * Lightbox modal to display project screenshot galleries.
 * An instance is generated for each project that has images.
 *
 * PURPOSE:
 * - Display project screenshots in a modal overlay
 * - Navigation between images (arrows, keyboard, thumbnails)
 * - Optimized viewing experience
 * - Support for WebP and lazy loading of thumbnails
 *
 * FEATURES:
 * - Fullscreen modal with dark overlay
 * - Navigation with prev/next buttons
 * - Keyboard navigation (arrows, Escape)
 * - Thumbnail strip for quick selection
 * - Automatic conversion to WebP for performance
 * - Lazy loading of thumbnails
 * - Image loading error handling
 * - Global function for opening from Projects
 *
 * ARCHITECTURE:
 * - HTML: Modal overlay + main image + thumbnails
 * - CSS: Fullscreen modal + responsive + transitions
 * - JavaScript: Navigation + keyboard + global function
 * - Optimization: WebP conversion + lazy thumbnails
 *
 * INTEGRATION:
 * - Called from Projects.astro for each project with images
 * - The [images] buttons call window[`open_${galleryId}`](0)
 * - Each gallery has a unique ID based on the project title
 *
 * PERFORMANCE:
 * - WebP: Images automatically converted to WebP
 * - Thumbnails: Small versions for fast loading
 * - Lazy loading: Thumbnails are loaded on demand
 * - Transitions: Smooth fade between images
 *
 * ACCESSIBILITY:
 * - role="dialog": Semantic modal
 * - aria-modal="true": Indicates modality
 * - aria-label: Descriptive labels
 * - Keyboard navigation: Arrows + Escape
 */

// PROPS
// -----
interface Props {
  images: string[];      // Array of image paths (without extension)
  projectTitle: string;  // Project title (used for IDs)
}

const { images, projectTitle } = Astro.props;

// PROPS VALIDATION
// --------------------
// Verifies that the props are valid before generating the component
// Throws errors at build time if there are problems

if (!images || !Array.isArray(images) || images.length === 0) {
  throw new Error(`ImageGallery: 'images' prop must be a non-empty array. Received: ${images}`);
}

if (!projectTitle || typeof projectTitle !== 'string') {
  throw new Error(`ImageGallery: 'projectTitle' prop must be a non-empty string. Received: ${projectTitle}`);
}

// UNIQUE GALLERY ID
// --------------------
// Generates a unique ID based on the project title
// Example: "My Project" → "gallery-my-project"
const galleryId = `gallery-${projectTitle.toLowerCase().replace(/\s+/g, '-')}`;

/**
 * WEBP CONVERSION
 * -----------------
 * Converts image paths to WebP format for better performance.
 *
 * LOGIC:
 * - If it ends with .gif: Keeps as is (animated GIFs)
 * - If it ends with .webp: Already optimized, keeps
 * - Others: Adds .webp at the end
 *
 * EXAMPLES:
 * "/screenshots/project/img-01" → "/screenshots/project/img-01.webp"
 * "/screenshots/project/img-01.png" → "/screenshots/project/img-01.png.webp"
 * "/screenshots/project/animation.gif" → "/screenshots/project/animation.gif"
 *
 * NOTE:
 * You need to have the WebP versions of your images generated.
 * Recommended tool: cwebp (Google's CLI)
 */
const webpImages = images.map(img => {
  // if (img.endsWith('.gif')) return img;  // Keep animated GIFs
  // if (img.endsWith('.webp')) return img; // Already WebP
  // return img + '.webp';                  // Add .webp
  return img
});

/**
 * THUMBNAIL PATHS
 * --------------------
 * Generates paths to thumbnail (small) versions of the images.
 *
 * FOLDER CONVENTION:
 * Original image: /screenshots/project/img-01.webp
 * Thumbnail:       /thumbnails/screenshots/project/img-01_thumb.webp
 *
 * LOGIC:
 * 1. Replaces /screenshots/ with /thumbnails/screenshots/
 * 2. Adds _thumb before the extension
 *
 * EXAMPLES:
 * "/screenshots/project/img-01" → "/thumbnails/screenshots/project/img-01_thumb.webp"
 * "/screenshots/project/img-01.webp" → "/thumbnails/screenshots/project/img-01_thumb.webp"
 *
 * THUMBNAIL GENERATION:
 * You need to generate thumbnails (e.g., 200x200px) for fast loading.
 * Tool: ImageMagick, Sharp, or cwebp with resize
 */
const thumbnailImages = images.map(img => {
  // if (img.endsWith('.gif')) return img;  // Keep GIFs as they are
  // if (img.endsWith('.webp')) {
  //   // For WebP: replace path and extension
  //   return img.replace(/^\/screenshots\//, '/thumbnails/screenshots/').replace(/\.webp$/, '_thumb.webp');
  // }
  // // For others: replace path and add _thumb.webp
  // return img.replace(/^\/screenshots\//, '/thumbnails/screenshots/') + '_thumb.webp';
  return img
});
---

<!--
  GALLERY MODAL
  ================

  STRUCTURE:
  - Fullscreen modal with dark overlay
  - X button to close (top right corner)
  - Centered main image
  - Prev/next buttons for navigation
  - Thumbnail strip at the bottom

  ACCESSIBILITY:
  - role="dialog": Indicates it's a modal dialog
  - aria-modal="true": Modality (blocks interaction with background)
  - aria-label: Description of the gallery
  - aria-hidden: Decorative overlay hidden from screen readers

  OPERATION:
  - Initially hidden (display: none)
  - JavaScript adds "active" class to show it
  - X button, overlay, and Escape close the gallery
  - Arrows and thumbnails navigate between images
-->
<div
  class="gallery-modal"
  id={galleryId}
  role="dialog"
  aria-modal="true"
  aria-label={`${projectTitle} image gallery`}
>
  <!-- Dark background overlay -->
  <div class="modal-overlay" aria-hidden="true"></div>

  <!-- Modal content -->
  <div class="modal-content">
    <!-- Close button (X) -->
    <button class="modal-close" aria-label="Close gallery">×</button>

    <!-- Body: image + navigation buttons -->
    <div class="modal-body">
      <!-- Previous button (‹) -->
      <button class="nav-btn prev" aria-label="Previous image">‹</button>

      <!-- Main image container -->
      <div class="image-container">
        <img src="" alt={`Example image of the ${projectTitle} project`} />
      </div>

      <!-- Next button (›) -->
      <button class="nav-btn next" aria-label="Next image">›</button>
    </div>

    <!--
      THUMBNAIL STRIP:
      Buttons with thumbnails of all images
      Allows direct image selection
    -->
    <div class="thumbnail-strip" role="tablist" aria-label="Image thumbnails">
      {images.map((img, index) => (
        <button
          class="thumbnail"
          data-index={index}
          role="tab"
          aria-label={`View image ${index + 1} of ${images.length}`}
        >
          <img
            src={thumbnailImages[index]}
            alt={`Example image of the ${projectTitle} project`}
            loading="lazy"
            decoding="async"
          />
        </button>
      ))}
    </div>
  </div>
</div>

<style>
  /**
   * STYLES: ImageGallery
   * ----------------------
   *
   * Fullscreen lightbox for image viewing.
   *
   * DESIGN:
   * - Fullscreen modal with 95% black overlay
   * - Centered main image with max-height
   * - Navigation buttons on the sides
   * - Thumbnail strip at the bottom
   * - Smooth fade transitions
   *
   * RESPONSIVE:
   * - Desktop: Large buttons (3rem), thumbnails 80px
   * - Mobile: Small buttons (2.5rem), thumbnails 60px
   * - Reduced gap on mobile to save space
   */

  .gallery-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1000;
  }

  .gallery-modal.active {
    display: block;
  }

  .modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.95);
  }

  .modal-content {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 2rem;
  }

  .modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: transparent;
    border: 2px solid #ffffff;
    color: #ffffff;
    font-size: 2rem;
    width: 3rem;
    height: 3rem;
    cursor: pointer;
    z-index: 10;
    font-family: var(--mono);
    line-height: 1;
    transition: all 0.2s;
  }

  .modal-close:hover {
    background: #ffffff;
    color: #000000;
  }

  .modal-body {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    margin-bottom: 2rem;
    min-height: 0;
    overflow: hidden;
  }

  .image-container {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    max-height: 100%;
    max-width: 100%;
    min-height: 0;
    min-width: 0;
  }

  .image-container img {
    max-width: 100%;
    max-height: calc(100vh - 250px);
    width: auto;
    height: auto;
    object-fit: contain;
    border: 1px solid var(--border);
    transition: opacity 0.3s ease;
  }

  .image-container img:not([src]) {
    opacity: 0;
  }

  .image-container img[src] {
    opacity: 1;
  }

  .nav-btn {
    background: transparent;
    border: 2px solid #ffffff;
    color: #ffffff;
    font-size: 3rem;
    width: 3rem;
    height: 3rem;
    cursor: pointer;
    font-family: var(--mono);
    line-height: 1;
    transition: all 0.2s;
  }

  .nav-btn:hover {
    background: #ffffff;
    color: #000000;
  }

  .thumbnail-strip {
    display: flex;
    gap: 1rem;
    justify-content: center;
    overflow-x: auto;
    padding: 1rem 0;
    max-width: 100%;
  }

  .thumbnail {
    flex-shrink: 0;
    width: 80px;
    height: 80px;
    border: 2px solid var(--border);
    background: transparent;
    cursor: pointer;
    padding: 0;
    transition: border-color 0.2s;
  }

  .thumbnail:hover,
  .thumbnail.active {
    border-color: var(--text);
  }

  .thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease;
  }

  .thumbnail img:not([src]) {
    opacity: 0;
  }

  .thumbnail img[src] {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .modal-content {
      padding: 1rem;
    }

    .modal-body {
      gap: 0.5rem;
    }

    .nav-btn {
      width: 2.5rem;
      height: 2.5rem;
      font-size: 2rem;
    }

    .thumbnail {
      width: 60px;
      height: 60px;
    }
  }
</style>

<script define:vars={{ galleryId, images, webpImages }}>
  /**
   * SCRIPT: ImageGallery Navigation System
   * =======================================
   *
   * JavaScript for the full functionality of the image gallery.
   * Uses define:vars from Astro to pass variables from the server to the client.
   *
   * FUNCTIONALITIES:
   * 1. Navigation between images (prev/next/thumbnails)
   * 2. Keyboard navigation (arrows, Escape)
   * 3. Opening/closing of gallery
   * 4. Updating of active image and thumbnail
   * 5. Load error handling
   * 6. Global function for opening from Projects
   *
   * INJECTED VARIABLES (define:vars):
   * - galleryId: Unique ID of this gallery
   * - images: Array of original paths
   * - webpImages: Array of paths converted to WebP
   *
   * NAVIGATION:
   * - Prev/Next: ‹ and › buttons
   * - Thumbnails: Click on thumbnail
   * - Keyboard: ArrowLeft, ArrowRight, Escape
   * - Circular: After the last image it goes back to the first
   *
   * GLOBAL FUNCTION:
   * window[`open_${galleryId}`] = openGallery
   * Allows Projects.astro to open this specific gallery
   * Example: window['open_gallery-my-project'](0)
   */

  // DOM REFERENCES
  // ------------------
  // Find the elements of this specific gallery
  const modal = document.getElementById(galleryId);
  if (!modal) return;  // If the modal doesn't exist, exit

  const overlay = modal.querySelector('.modal-overlay');        // Dark overlay
  const closeBtn = modal.querySelector('.modal-close');         // X button
  const prevBtn = modal.querySelector('.prev');                 // ‹ button
  const nextBtn = modal.querySelector('.next');                 // › button
  const img = modal.querySelector('.image-container img');      // Main image
  const thumbnails = modal.querySelectorAll('.thumbnail');      // All thumbnails

  // STATE
  // ------
  let currentIndex = 0;  // Index of the current image (0-based)

  // ERROR HANDLING
  // -----------------
  // If an image fails to load, update the alt text
  img.addEventListener('error', () => {
    img.alt = 'Image failed to load';
  });

  function showImage(index) {
    if (index < 0 || index >= webpImages.length) {
      return;
    }

    currentIndex = index;
    img.src = webpImages[index];

    thumbnails.forEach((thumb, i) => {
      thumb.classList.toggle('active', i === index);
    });
  }

  function openGallery(startIndex = 0) {
    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
    showImage(startIndex);
  }

  function closeGallery() {
    modal.classList.remove('active');
    document.body.style.overflow = '';
  }

  function nextImage() {
    const newIndex = (currentIndex + 1) % images.length;
    showImage(newIndex);
  }

  function prevImage() {
    const newIndex = (currentIndex - 1 + images.length) % images.length;
    showImage(newIndex);
  }

  // Event listeners
  closeBtn?.addEventListener('click', closeGallery);
  overlay?.addEventListener('click', closeGallery);
  prevBtn?.addEventListener('click', prevImage);
  nextBtn?.addEventListener('click', nextImage);

  thumbnails.forEach((thumb, index) => {
    thumb.addEventListener('click', () => showImage(index));
  });

  // Keyboard navigation
  document.addEventListener('keydown', (e) => {
    if (!modal.classList.contains('active')) return;

    if (e.key === 'Escape') closeGallery();
    if (e.key === 'ArrowRight') nextImage();
    if (e.key === 'ArrowLeft') prevImage();
  });

  // ===== GLOBAL FUNCTION =====
  // Exposes openGallery globally for this specific gallery
  // Projects.astro calls this function to open the gallery
  // Example: window['open_gallery-my-project'](0)
  window[`open_${galleryId}`] = openGallery;

  /**
   * NAVIGATION FLOW:
   * ====================
   *
   * 1. OPENING:
   *    - Projects.astro calls window[`open_${galleryId}`](0)
   *    - 'active' class is added to the modal
   *    - Body scroll is blocked
   *    - The image at the specified index is shown
   *
   * 2. VIEWING:
   *    - Main image is loaded from webpImages[currentIndex]
   *    - Active thumbnail is visually marked
   *    - Prev/next buttons are always available (circular navigation)
   *
   * 3. NAVIGATION:
   *    - Prev: (currentIndex - 1 + images.length) % images.length
   *    - Next: (currentIndex + 1) % images.length
   *    - Thumbnail: Direct click on thumbnail
   *    - Keyboard: ArrowLeft/Right change image
   *
   * 4. CLOSING:
   *    - Click on X, overlay, or Escape key
   *    - 'active' class is removed from the modal
   *    - Body scroll is restored
   *    - Current image is kept for next opening
   *
   * OPTIMIZATIONS:
   * - WebP: Optimized format for web
   * - Lazy loading: Thumbnails are loaded on demand
   * - Fade transitions: Smooth changes between images
   * - Circular navigation: No limits, you can always navigate
   */
</script>

<!--
  HOW TO USE THIS COMPONENT
  =========================

  1. IN PROJECTS-DATA.TS:
     Add the images field to your project:
     images: [
       "/screenshots/my-project/img-01",
       "/screenshots/my-project/img-02",
       "/screenshots/my-project/img-03"
     ]

  2. FOLDER STRUCTURE:
     public/
       screenshots/
         my-project/
           img-01.webp  ← Original image
           img-02.webp
           img-03.webp
       thumbnails/
         screenshots/
           my-project/
             img-01_thumb.webp  ← Thumbnail
             img-02_thumb.webp
             img-03_thumb.webp

  3. GENERATE WEBP:
     Use cwebp (Google's tool):
     cwebp img-01.png -o img-01.webp

  4. GENERATE THUMBNAILS:
     Use cwebp with resize:
     cwebp img-01.png -resize 200 0 -o img-01_thumb.webp

  5. AUTOMATIC OPENING:
     Projects.astro already handles the opening automatically
     when the user clicks the [images] button
-->
