---
/**
 * LAYOUT: Main HTML Wrapper
 * ==========================
 *
 * Main wrapper component that generates the complete HTML structure.
 * All pages (.astro) use this layout for a consistent structure.
 *
 * PURPOSE:
 * - Generate HTML structure (<html>, <head>, <body>)
 * - Configure meta tags for SEO
 * - Configure Open Graph for social media
 * - Include global fonts and resources
 * - Include global components (ThemeToggle, LanguageSwitcher)
 * - Import global styles
 * - Configure JSON-LD for Google Rich Snippets
 *
 * FEATURES:
 * - Full SEO: title, description, canonical, alternates
 * - Open Graph: Facebook, Twitter cards
 * - JSON-LD: Structured data for Google
 * - Multilingual: hreflang tags for international SEO
 * - Performance: Preconnect to Google Fonts
 * - Analytics: Ready for Google Analytics
 *
 * USAGE:
 * <Layout title="My Page" description="Description">
   <YourContent />
 </Layout>
 *
 * CUSTOMIZATION:
 * - Meta tags: Edit below in the corresponding section
 * - JSON-LD: Update your personal information (lines 82-100)
 * - Google Analytics: Uncomment and add your ID (lines 104-111)
 * - Twitter: Update @yourusername (line 70)
 * - OG Image: Create /public/og-image.jpg (1200x630px recommended)
 */

import ThemeToggle from '../components/ThemeToggle.astro';
import Navbar from '../components/Navbar.astro';

// PROPS
// -----
interface Props {
  title: string;         // Page title (required)
  description?: string;  // Meta description for SEO
  image?: string;        // Open Graph image (social media)
}

// Gets props with default values
const {
  title,
  description = "Tech portfolio - Full stack developer",
  image = '/og-image.jpg'
} = Astro.props;

/**
 * CANONICAL URL:
 * Canonical URL of the current page.
 * Tells Google which is the "official" version of this page.
 * Prevents duplicate content problems.
 */
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

/**
 * OPEN GRAPH IMAGE:
 * Full URL of the image for Open Graph.
 * Necessary for preview on Facebook, Twitter, etc.
 *
 * REQUIREMENTS:
 * - Recommended size: 1200x630px
 * - Format: JPG or PNG
 * - Location: public/og-image.jpg
 */
const ogImage = new URL(image, Astro.site);
---

<!--
  HTML STRUCTURE
  ===============

  This layout generates the complete HTML structure of each page.
  It is used in index.astro, en/index.astro and future pages.

  SECTIONS:
  - <head>: Meta tags, styles, fonts, scripts
  - <body>: Global components + page content
-->
<!doctype html>
<html>
  <head>
    <!--
      BASIC META TAGS
      -----------------
      charset: UTF-8 to support all characters
      viewport: Responsive design for mobiles
      generator: Indicates that the site was generated with Astro
    -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!--
      PRIMARY META TAGS (SEO)
      -----------------------
      The most important for Google and other search engines.

      title: Appears in the browser tab and search results
      description: Summary that appears in Google results
    -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!--
      CANONICAL URL
      -------------
      Tells Google which is the "official" URL of this page.
      Prevents duplicate content problems.

      BENEFIT:
      If you have example.com/ and example.com/index.html, canonical says
      which is the version that Google should index.
    -->
    <link rel="canonical" href={canonicalURL} />

    <!--
      OPEN GRAPH (FACEBOOK)
      ---------------------
      Meta tags for preview when you share on Facebook, LinkedIn, WhatsApp.

      CUSTOMIZE:
      - og:site_name: Name of your portfolio (line 132)
      - og:image: Create image in public/og-image.jpg (1200x630px)

      BENEFIT:
      Attractive preview when sharing on social media.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Your Portfolio" />  <!-- CHANGE -->
    <meta property="og:locale" content='en_US' />

    <!--
      TWITTER CARD
      ------------
      Meta tags for preview when you share on Twitter/X.

      twitter:card: Type of card (summary_large_image = large image)
      twitter:creator: Your Twitter username

      CUSTOMIZE:
      - twitter:creator: @your_username (line 142)

      BENEFIT:
      Attractive preview when sharing on Twitter.
    -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:creator" content="@yourusername" />  <!-- CHANGE -->

    <!--
      FAVICONS
      --------
      Icons that appear in the browser tab.

      CUSTOMIZE:
      Create favicon.ico in public/
      Recommended size: 32x32px or 16x16px
      Tool: https://favicon.io/
    -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="shortcut icon" href="/favicon.ico" />

    <!--
      FONTS (GOOGLE FONTS)
      --------------------
      Loads the JetBrains Mono font (monospace).

      preconnect: Optimization to load faster
      display=swap: Shows text immediately with system font
                    until JetBrains Mono loads

      CHANGE FONT:
      1. Go to https://fonts.google.com/
      2. Select your font
      3. Copy the <link> and replace below
      4. Update --mono in global.css
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />

    <!--
      JSON-LD STRUCTURED DATA
      -----------------------
      Structured data that Google uses for Rich Snippets.
      Appears in search results with highlighted information.

      CUSTOMIZE:
      - name: Your full name
      - sameAs: Your social profiles
      - jobTitle: Your professional title
      - knowsAbout: Your main skills

      BENEFIT:
      Google can show your profile with photo, skills, etc.
      in search results.
    -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Muhammad Haekal Muhyidin Al-Araby",  // CHANGE
      "url": Astro.site?.toString(),
      "image": ogImage.toString(),
      "sameAs": [  // CHANGE: Your social networks
        "https://github.com/muhhae",
        "https://twitter.com/yourusername"
      ],
      "jobTitle": "Undergraduate Researcher - Systems",  // CHANGE
      "description": description,
      "knowsAbout": [  // CHANGE: Your skills
        "C/C++",
        "Python",
        "Linux",
        "Bash",
        "libCacheSim",
        "CloudLab",
      ]
    })} />

    <!--
      GOOGLE ANALYTICS
      ----------------
      Tracking of visits, page views, events, etc.

      ACTIVATE:
      1. Create an account at https://analytics.google.com/
      2. Get your Measurement ID (format: G-XXXXXXXXXX)
      3. Replace G-XXXXXXXXXX in the 2 lines below
      4. Uncomment the entire block

      TRACKED EVENTS:
      - Theme changes (ThemeToggle)
      - Language changes (LanguageSwitcher)
      - Clicks on projects (Projects)
      - Email revelation (Footer)
    -->
    <!-- <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXXXXX');  // CHANGE to your ID
    </script> -->
  </head>

  <!--
    BODY: Page Content
    =============================

    GLOBAL COMPONENTS:
    - ThemeToggle: Floating button to change theme (top right)
    - LanguageSwitcher: Floating button to change language (top right)

    SLOT:
    The content of each page is inserted here.
    Example: In index.astro, <Layout> wraps Hero, Projects, Footer.
    Those components are rendered in the <slot />.
  -->
  <body>
    <!-- Navbar -->
    <Navbar />

    <!-- Theme toggle button (light/dark) -->
    <ThemeToggle />

    <!-- Current page content -->
    <slot />
  </body>
</html>

<!--
  GLOBAL STYLES
  ================

  Imports the global CSS styles from the global.css file.
  is:global indicates that they are global styles (not scoped to this component).

  CONTENT OF GLOBAL.CSS:
  - CSS Reset
  - CSS Variables (colors, fonts)
  - Base styles (body, h1-h6, p, a, etc.)
  - Utilities (container, mono, border-top, fade-in)
  - Smooth scroll
  - Light/dark theme
-->
<style is:global>
  @import '../styles/global.css';

  body {
    padding-top: 3.5rem; /* Adjust this value based on the navbar height */
  }
</style>

<!--
  HOW TO USE THIS LAYOUT
  =====================

  On any .astro page:

  ---
  import Layout from '../layouts/Layout.astro';
  ---

  <Layout
    title="My Page - Portfolio"
    description="Description of my page"
  >
    <YourContent />
  </Layout>

  AVAILABLE PROPS:
  - title (required): Page title
  - description (optional): Meta description
  - image (optional): Path to OG image (default: '/og-image.jpg')
-->
